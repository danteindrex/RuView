{
  "name": "Insight Report",
  "module": "RuView Care",
  "doctype": "DocType",
  "track_changes": 1,
  "fields": [
    {"fieldname": "session", "label": "CSI Session", "fieldtype": "Link", "options": "CSI Session", "reqd": 1, "in_list_view": 1},
    {"fieldname": "deployment", "label": "Deployment", "fieldtype": "Link", "options": "RuView Deployment", "fetch_from": "session.deployment", "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "risk_score", "label": "Risk Score", "fieldtype": "Float", "precision": 2, "in_list_view": 1},
    {"fieldname": "risk_level", "label": "Risk Level", "fieldtype": "Select", "options": "\nlow\nmoderate\nhigh\ncritical", "default": "low", "in_list_view": 1},
    {"fieldname": "section_break_vitals", "fieldtype": "Section Break", "label": "Vital Signs"},
    {"fieldname": "hr_classification", "label": "HR Classification", "fieldtype": "Data"},
    {"fieldname": "br_classification", "label": "BR Classification", "fieldtype": "Data"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "fall_risk_score", "label": "Fall Risk Score (%)", "fieldtype": "Float", "precision": 1},
    {"fieldname": "trend_direction", "label": "Trend Direction", "fieldtype": "Select", "options": "\nimproving\nstable\ndeteriorating", "default": "stable"},
    {"fieldname": "section_break_output", "fieldtype": "Section Break", "label": "AI Output"},
    {"fieldname": "summary", "label": "Summary", "fieldtype": "Long Text"},
    {"fieldname": "action_items", "label": "Action Items", "fieldtype": "Long Text"},
    {"fieldname": "section_break_meta", "fieldtype": "Section Break", "label": "Metadata"},
    {"fieldname": "agent_trace_id", "label": "Agent Trace ID", "fieldtype": "Data"},
    {"fieldname": "confidence", "label": "Confidence (%)", "fieldtype": "Percent"}
  ],
  "permissions": [
    {"role": "RuView Enterprise Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1},
    {"role": "RuView Clinical Staff",   "read": 1, "export": 1},
    {"role": "RuView Operator",         "read": 1, "write": 1, "create": 1},
    {"role": "RuView Viewer",           "read": 1}
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "title_field": "session"
}
