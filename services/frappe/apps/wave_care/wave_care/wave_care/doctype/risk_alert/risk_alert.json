{
  "name": "Risk Alert",
  "module": "Wave Care",
  "doctype": "DocType",
  "track_changes": 1,
  "fields": [
    {"fieldname": "deployment", "label": "Deployment", "fieldtype": "Link", "options": "Wave Deployment", "reqd": 1, "in_list_view": 1},
    {"fieldname": "deployment_name", "label": "Deployment Name", "fieldtype": "Data", "fetch_from": "deployment.deployment_name", "read_only": 1, "in_list_view": 1, "in_global_search": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "risk_level", "label": "Risk Level", "fieldtype": "Select", "options": "\nmoderate\nhigh\ncritical", "reqd": 1, "in_list_view": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "\nOpen\nAcknowledged\nResolved", "default": "Open", "in_list_view": 1},
    {"fieldname": "section_break_details", "fieldtype": "Section Break", "label": "Details"},
    {"fieldname": "location", "label": "Location", "fieldtype": "Data"},
    {"fieldname": "alert_time", "label": "Alert Time", "fieldtype": "Datetime"},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "acknowledged_by", "label": "Acknowledged By", "fieldtype": "Link", "options": "User"},
    {"fieldname": "section_break_resolution", "fieldtype": "Section Break", "label": "Resolution"},
    {"fieldname": "resolution_notes", "label": "Resolution Notes", "fieldtype": "Text"}
  ],
  "permissions": [
    {"role": "Wave Enterprise Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1},
    {"role": "Wave Clinical Staff",   "read": 1, "write": 1},
    {"role": "Wave Operator",         "read": 1},
    {"role": "Wave Viewer",           "read": 1}
  ],
  "sort_field": "alert_time",
  "sort_order": "DESC",
  "title_field": "deployment_name"
}
