    {"fieldname": "check_in_time",         "label": "Check-in Time",        "fieldtype": "Datetime",  "reqd": 1},
    {"fieldname": "check_out_time",        "label": "Check-out Time",       "fieldtype": "Datetime"},
    {"fieldname": "status",                "label": "Status",               "fieldtype": "Select",    "options": "Active\nCompleted\nAbandoned", "default": "Active", "in_list_view": 1},
    {"fieldname": "total_duration_seconds","label": "Total Duration (s)",   "fieldtype": "Int",       "read_only": 1},
    {"fieldname": "section_break_csi",     "label": "CSI Enrollment",       "fieldtype": "Section Break"},
    {"fieldname": "enrollment_embedding",  "label": "Enrollment Embedding", "fieldtype": "Long Text"},
    {"fieldname": "enrollment_node_id",    "label": "Enrollment Node ID",   "fieldtype": "Data"},
